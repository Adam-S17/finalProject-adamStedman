---
import "../styles/styles.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous"
        />
        <title>Backpackers Travel - Planner</title>
    </head>

    <body>
        <Header />
        <!--Add/remove destinations and tours dynamically
    Notes section: save user notes
    Display a summary itinerary with dates and destinations.
    Drag-and-drop reorder for planning trips.-->
        <main class="container my-5">
            <section class="mb-5">
                <h1 class="mb-3">Travel Planner</h1>
                <p class="lead">
                    Plan your next adventure with our easy-to-use travel
                    planner. Select your destinations, dates, and preferences to
                    create a personalized itinerary
                </p>
                <!-- Additional planner content can go here -->
            </section>
            <section>
                <!--Add trip form-->
                <div
                    class="card shadow-lg border-0 rounded-4 p-4 mb-5 planner__card"
                >
                    <h2 class="mb-4 text-center fw-semibold">
                        Plan your next adventure
                    </h2>
                    <form id="plannerForm">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label fw-medium"
                                    >Trip Name</label
                                >
                                <input
                                    type="text"
                                    id="tripName"
                                    class="form-control form-control-lg rounded-3"
                                    placeholder="Trip or Tour Name"
                                    required
                                />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-medium"
                                    >Travel Date</label
                                >
                                <input
                                    type="date"
                                    id="tripDate"
                                    class="form-control form-control-lg rounded-3"
                                    required
                                />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-medium"
                                    >Location</label
                                >
                                <input
                                    type="text"
                                    id="tripLocation"
                                    class="form-control form-control-lg rounded-3"
                                    placeholder="Location"
                                    required
                                />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-medium">Notes</label
                                >
                                <textarea
                                    id="tripNotes"
                                    class="form-control form-control-lg rounded-3"
                                    rows="3"
                                    placeholder="Notes (Optional)"></textarea>
                            </div>
                        </div>
                        <div class="text-center mt-4">
                            <button
                                type="submit"
                                class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm"
                                >Add to Planner</button
                            >
                        </div>
                    </form>
                </div>
            </section>

            <section class="mb-5">
                <h3>My Planner</h3>
                <div id="plannerItems" class="row g-4">
                    <!-- Dynamically populated planner items will appear here -->
                </div>
            </section>

            <section class="mb-5">
                <h3>Saved Destinations</h3>
                <div id="savedDestinations" class="row g-4">
                    <!-- Dynamically populated list of saved destinations -->
                </div>
            </section>

            <section class="mb-5">
                <h3>Saved Tours</h3>
                <div id="savedTours" class="row g-4">
                    <!-- Dynamically populated list of saved tours -->
                </div>
            </section>
        </main>
        <Footer />
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>
        <script>
            import "../scripts/main.js";
        </script>
    </body>
</html>
