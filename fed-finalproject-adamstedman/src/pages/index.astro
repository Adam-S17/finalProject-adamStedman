---
import "../styles/styles.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Carousel from "../components/Carousel.astro";

interface Slide {
    image: string;
    alt: string;
    title: string;
    caption: string;
}

const carouselSlides: Slide[] = [
    {
        image: "https://images.unsplash.com/photo-1552465011-b4e21bf6e79a?w=1200&auto=format&fit=crop&q=80",
        alt: "Koh Phi Phi, Thailand — turquoise waters and limestone cliffs",
        title: "Koh Phi Phi, Thailand",
        caption: "Experience the stunning beaches and crystal clear waters of Koh Phi Phi." 
    },
    {
        image: "https://images.unsplash.com/photo-1616438096679-620332ede3a2?q=80&w=1200&auto=format&fit=crop",
        alt: "Hanoi, Vietnam — bustling Old Quarter streets",
        title: "Hanoi, Vietnam",
        caption: "Discover the vibrant culture and bustling streets of Hanoi."
    },
    {
        image: "https://images.unsplash.com/photo-1739591816074-3dfde2faf16b?q=80&w=1200&auto=format&fit=crop",
        alt: "Vang Vieng, Laos — karst mountains and Nam Song River",
        title: "Vang Vieng, Laos",
        caption: "Experience the beautiful landscapes and unique culture of Vang Vieng."
    },
    {
        image: "https://images.unsplash.com/photo-1508804185872-d7badad00f7d?w=1200&auto=format&fit=crop&q=80",
        alt: "Beijing, China — Great Wall stretching across the mountains",
        title: "Beijing, China",
        caption: "Walk the legendary Great Wall and explore China's ancient imperial capital."
    },
    {
        image: "https://images.unsplash.com/photo-1541343672885-9be56236302a?w=1200&auto=format&fit=crop&q=80",
        alt: "Budapest, Hungary — illuminated Parliament building on the Danube",
        title: "Budapest, Hungary",
        caption: "Soak in thermal baths and admire the stunning Danube skyline."
    }
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta
            name="description"
            content="Backpackers travel your go-to resource for
                            planning unforgettable backpacking adventures around
                            the world Explore destinations, find tours, and get travel tips."
        />
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous"
        />
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
        />
        <title>Backpackers Travel</title>
    </head>

    <body>
        <Header />

        <main class="container my-5">
            <div class="row">
                <div class="col-lg-9">
                    <section class="mb-5">
                        <h1 class="mb-3">Welcome to Backpackers Travel</h1>
                        <p class="lead">
                            Backpackers Travel is your go-to resource for
                            planning unforgettable backpacking adventures around
                            the world. View our featured destinations and get
                            inspired for your next trip! We have live weather
                            updates for all our featured destinations and more.
                            Look at recommended tips form other travelers on our
                            Travel Tips page!
                        </p>
                    </section>
                    <section>
                        <h2>Featured Destinations</h2>
                        <p>
                            Look at some of our current featured destinations
                            and get inspired for your next trip!
                        </p>
                        <Carousel slides={carouselSlides} />
                    </section>
                    <section class="mb-5 mt-5">
                        <h2 class="mb-4">What You Can Do</h2>

                        <div class="row">
                            <div class="col-md-4">
                                <a
                                    href="/destinations"
                                    class="text-decoration-none text-dark"
                                    aria-label="Explore travel destinations"
                                >
                                    <div
                                        class="card h-100 shadow-sm hover-card"
                                    >
                                        <div class="card-body">
                                            <h5 class="card-title">
                                                Explore Destinations
                                            </h5>
                                            <p class="card-text">
                                                Browse destinations with maps,
                                                weather, and backpacker tips.
                                            </p>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-4">
                                <a
                                    href="/tours"
                                    class="text-decoration-none text-dark"
                                    aria-label="Find tours"
                                >
                                    <div
                                        class="card h-100 shadow-sm hover-card"
                                    >
                                        <div class="card-body">
                                            <h5 class="card-title">
                                                Find Tours
                                            </h5>
                                            <p class="card-text">
                                                Discover trending tours and
                                                activities from trusted
                                                providers.
                                            </p>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-4">
                                <a
                                    href="/planner"
                                    class="text-decoration-none text-dark"
                                    aria-label="Plan your trip"
                                >
                                    <div
                                        class="card h-100 shadow-sm hover-card"
                                    >
                                        <div class="card-body">
                                            <h5 class="card-title">
                                                Plan Your Trip
                                            </h5>
                                            <p class="card-text">
                                                Save destinations, add notes,
                                                and build your itinerary.
                                            </p>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </section>
                    <section class="mb-5">
                        <h2 class="mb-4">Latest Travel Tips</h2>
                        <ul class="list-group" id="latestTips">
                            <!-- Dynamically populated list of recent tips -->
                        </ul>
                        <p class="mt-3">
                            <a href="/tips">See all tips &raquo;</a>
                        </p>
                    </section>
                </div>

                <div class="col-lg-3">
                    <section class="mb-4">
                        <div class="card p-3 mb-4 shadow-sm">
                            <img
                                src="https://media.licdn.com/dms/image/v2/D4E03AQHHku36aqKzsQ/profile-displayphoto-shrink_200_200/profile-displayphoto-shrink_200_200/0/1676035953109?e=1773273600&v=beta&t=-D-2CSi9rZ6OAh2HZMpDKfZS_yvPUMkDEG9DXGraxkQ"
                                class="card-img-top rounded-circle mb-3"
                                alt="Adam Stedman"
                            />
                            <h3 class="card-title text-center mb-3">
                                About Me
                            </h3>
                            <p class="card-text text-center">
                                I'm Adam Stedman, a passionate backpacker and
                                travel enthusiast. I've been exploring the world
                                for over 10 years and have created this website
                                to share my experiences and help fellow
                                travelers plan their adventures.
                            </p>
                        </div>
                    </section>

                    <!--Placeholder-->
                    <section class="mb-4">
                        <div class="card p-3 shadow-sm">
                            <h3 class="card-title text-center mb-3">
                                My Stats
                            </h3>
                            <ul class="list-unstyled text-center">
                                <li><strong>Countries Visited:</strong> 36</li>
                                <li><strong>Continents Explored:</strong> 4</li>
                                <li><strong>Destinations:</strong> 82</li>
                                <li><strong>Trips Taken:</strong> 50+</li>
                                <li>
                                    <strong>Favorite Destination:</strong> Vietnam
                                </li>
                            </ul>
                        </div>
                    </section>
                </div>
            </div>
        </main>
        <Footer />
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>
        <script>
            import "../scripts/main.js";
        </script>
    </body>
</html>
