---
import "../styles/styles.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous"
        />
        <link
            rel="stylesheet"
            href="https://unpkg.com/leaflet/dist/leaflet.css"
        />
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
        />
        <title>Backpackers Travel - Destinations</title>
    </head>

    <body>
        <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
        <Header />

        <main class="container my-5">
            <section class="mb-5">
                <h1 class="mb-3">Destinations</h1>
                <p class="lead">
                    Discover your next adventure! Browse handpicked
                    destinations, see current weather, and get inspired for your
                    travels — all in one place.
                </p>
            </section>
            <section class="mb-5">
                <h2>Weather Map</h2>
                <p>Click on a destination to view details.</p>
                <!-- Map container for Leaflet -->
                <div class="row g-4">
                    <div class="col-lg-8">
                        <div id="map" class="rounded h-100"></div>
                    </div>
                    <div class="col-lg-4 d-flex">
                        <div class="card p-3 weather__panel flex-fill">
                            <h4>Selected destination's weather:</h4>
                            <div class="d-flex align-items-center mt-2">
                                <div>
                                    <p
                                        id="weatherLocation"
                                        class="fw-bold mb-1"
                                    >
                                        Click on the map to view destination
                                    </p>
                                    <p
                                        id="weatherDescription"
                                        class="mb-1 text-muted"
                                    >
                                        Weather info will appear here
                                    </p>
                                    <p
                                        id="weatherTemp"
                                        class="mb-0 fw-semi-bold"
                                    >
                                    </p>
                                    <img
                                        id="weatherIcon"
                                        src="https://via.placeholder.com/50"
                                        style="display:none;"
                                        alt="Weather icon"
                                        class="ms-2"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="mb-5 top-places">
                <h2>Our Top Destinations</h2>
                <div class="table-responsive">
                    <table
                        class="table table-striped table-hover"
                        id="topPlacesTable"
                    >
                        <thead class="table-primary">
                            <tr>
                                <th>#</th>
                                <th>Destination</th>
                                <th>Local Time</th>
                                <th>Temperature</th>
                                <th>Weather</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Placeholder rows - will be populated with JS -->
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="mb-5">
                <!-- Filter Options -->
                <h2>Filter by region:</h2>
                <!--Connect filters using JS-->
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <select id="regionFilter" class="form-select">
                            <option value="All">All Regions</option>
                            <option value="Asia">Asia</option>
                            <option value="Europe">Europe</option>
                            <option value="Africa">Africa</option>
                            <option value="North America">North America</option>
                            <option value="South America">South America</option>
                            <option value="Oceania">Oceania</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select id="typeFilter" class="form-select">
                            <option value="All">All Types</option>
                            <option value="Cultural">Cultural</option>
                            <option value="Beach">Beach</option>
                            <option value="Adventure">Adventure</option>
                            <option value="Urban">Urban</option>
                            <option value="Food & Drink"
                                >Food &amp; Drink</option
                            >
                        </select>
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <p>
                    Here is 12 random destinations be sure to filter down to
                    access all we have to show and be sure to hit the heart
                    button to save your favorites to the planner!:
                </p>
                <div class="container-fluid">
                    <div class="row g-2" id="featuredDestinations">
                        <!-- Placeholder for featured destination cards is populated with Javascript -->
                    </div>
                </div>
            </section>
        </main>
        <Footer />
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>
        <script>
            import "../scripts/main.js";
        </script>
    </body>
</html>
